# Shared
SOLANA_RPC_URL=http://127.0.0.1:8899
PROGRAM_ID=6cD9BZG2bddZZ1xoNReLVEvdYVaxpxY97F7MfZyov7XW
# Local/devnet USDC mint — replace after running scripts/setup-local.ts
USDC_MINT=
AUTHORITY_KEYPAIR=~/.config/solana/id.json
ORACLE_KEYPAIR=~/.config/solana/id.json
VERIDEX_DATA_DIR=./data
DRY_RUN=1

# Use local fixtures when Gamma is unreachable
USE_FIXTURES=1

# Indexer
INDEXER_POLL_MS=60000
INDEXER_MAX_CREATE_PER_TICK=5
INDEXER_EVENT_LIMIT=20

# Oracle
ORACLE_POLL_MS=30000
